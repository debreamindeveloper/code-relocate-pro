# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Entra ID (Azure AD) configuration for the /manage admin route
# Create an SPA app registration in Entra, then populate these values.
VITE_ENTRA_TENANT_ID=your_tenant_guid_here
VITE_ENTRA_CLIENT_ID=your_spa_app_client_id_here
VITE_ENTRA_REDIRECT_URI=http://localhost:8080
# Object ID of the Entra security group whose members may access /manage
VITE_ENTRA_ADMIN_GROUP_ID=your_admin_group_object_id_here

